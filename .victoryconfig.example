# Copy to .victoryconfig in the checkout root or next to the extracted run-test.py.
# A shared ~/.victoryconfig works across kits. Use plain paths without quotes.
# Relative paths start at this file. Spaces and Windows backslashes are literal.
[hardware]
game_dir = ~/games/GTA6.Xbox.v1.0.2.1
# Windows example: game_dir = D:\Games\GTA6.Xbox.v1.0.2.1
# For another executable, title takes precedence over game_dir.
# title = D:\Games\Game\title.exe
# Override automatic save discovery if you store it elsewhere.
# save_dir = saves/7952987A
# output_dir = ~/victory-reports
# Linux only; blank uses the launcher's existing discovery and prefix.
# proton_dir = ~/.local/share/Steam/steamapps/common/Proton - Experimental
# umu_dir = ~/.local/bin
# wine_prefix = ~/.local/share/victory/proton

# For older kits with no requested endpoint. Published endpoints take precedence.
# Keep manual for an older kit with written instructions. To automate a known scene,
# choose device-ready, present-1024, first-mesh-bind, dense-draws, or timing-window.
stop_after = manual
# observe_seconds = 180
# timeout_seconds = 900
